generator client {
  provider        = "prisma-client-js"
  output          = "../../backend/node_modules/.prisma/client"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String          @id @default(uuid()) @db.Uuid
  email         String          @unique
  passwordHash  String          @map("password_hash")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  accounts      Account[]
  categories    Category[]
  imports       Import[]
  sessions      Session[]
  subcategories subcategories[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id           String        @id @default(uuid()) @db.Uuid
  userId       String        @map("user_id") @db.Uuid
  name         String
  currency     String        @default("INR")
  balance      Decimal       @default(0) @db.Decimal(15, 2)
  isPrimary    Boolean       @default(false) @map("is_primary")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId])
  @@map("accounts")
}

model Category {
  id            String          @id @default(uuid()) @db.Uuid
  userId        String?         @map("user_id") @db.Uuid
  name          String
  type          CategoryType
  icon          String?
  color         String?
  is_default    Boolean         @default(false)
  user          User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  subcategories subcategories[]
  transactions  Transaction[]

  @@index([userId])
  @@index([type])
  @@map("categories")
}

model Transaction {
  id             String          @id @default(uuid()) @db.Uuid
  accountId      String          @map("account_id") @db.Uuid
  categoryId     String          @map("category_id") @db.Uuid
  subcategory_id String          @db.Uuid
  amount         Decimal         @db.Decimal(15, 2)
  type           TransactionType
  date           DateTime
  Title          String
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  account        Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category       Category        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  subcategory    subcategories   @relation(fields: [subcategory_id], references: [id], onDelete: SetNull)

  @@index([accountId])
  @@index([categoryId])
  @@index([date])
  @@index([type])
  @@index([subcategory_id])
  @@map("transactions")
}

model Import {
  id          String       @id @default(uuid()) @db.Uuid
  userId      String       @map("user_id") @db.Uuid
  fileName    String       @map("file_name")
  fileType    String       @map("file_type")
  status      ImportStatus @default(PENDING)
  totalRows   Int          @default(0) @map("total_rows")
  validRows   Int          @default(0) @map("valid_rows")
  invalidRows Int          @default(0) @map("invalid_rows")
  createdAt   DateTime     @default(now()) @map("created_at")
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("imports")
}

model subcategories {
  id           String        @id @db.Uuid
  category_id  String        @db.Uuid
  user_id      String?       @db.Uuid
  name         String
  icon         String?
  color        String?
  is_default   Boolean       @default(false)
  categories   Category      @relation(fields: [category_id], references: [id], onDelete: Cascade)
  users        User?         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([category_id])
  @@index([user_id])
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum CategoryType {
  INCOME
  EXPENSE
}

enum ImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum SuggestionSource {
  RULE
  SLM
}

enum SuggestionStatus {
  PENDING
  ACCEPTED
  OVERRIDDEN
}


// =========================
// USER
// =========================

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  sessions            Session[]
  accounts            Account[]
  categories          Category[]
  subcategories       Subcategory[]
  imports             Import[]
  categorizationRules CategorizationRule[]

  @@map("users")
}


// =========================
// SESSION
// =========================

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}


// =========================
// ACCOUNT
// =========================

model Account {
  id        String  @id @default(uuid()) @db.Uuid
  userId    String  @map("user_id") @db.Uuid
  name      String
  currency  String   @default("INR")
  balance   Decimal  @default(0) @db.Decimal(15, 2)
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId])
  @@map("accounts")
}


// =========================
// CATEGORY
// =========================

model Category {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String?      @map("user_id") @db.Uuid
  name      String
  type      CategoryType
  icon      String?
  color     String?
  isDefault Boolean      @default(false) @map("is_default")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  subcategories       Subcategory[]
  transactions        Transaction[]
  categorizationRules CategorizationRule[]
  suggestions         Suggestion[]

  @@index([userId])
  @@index([type])
  @@map("categories")
}


// =========================
// SUBCATEGORY
// =========================

model Subcategory {
  id        String  @id @default(uuid()) @db.Uuid
  categoryId String @map("category_id") @db.Uuid
  userId    String? @map("user_id") @db.Uuid
  name      String
  icon      String?
  color     String?
  isDefault Boolean @default(false) @map("is_default")

  category     Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([categoryId])
  @@index([userId])
  @@map("subcategories")
}


// =========================
// TRANSACTION
// =========================

model Transaction {
  id            String          @id @default(uuid()) @db.Uuid
  accountId     String          @map("account_id") @db.Uuid
  categoryId    String?         @map("category_id") @db.Uuid
  subcategoryId String?         @map("subcategory_id") @db.Uuid
  amount        Decimal         @db.Decimal(15, 2)
  type          TransactionType
  date          DateTime
  description   String?
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  account      Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category     Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  subcategory  Subcategory?  @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)
  suggestions  Suggestion[]

  @@index([accountId])
  @@index([categoryId])
  @@index([subcategoryId])
  @@index([date])
  @@index([type])
  @@map("transactions")
}


// =========================
// IMPORT
// =========================

model Import {
  id          String       @id @default(uuid()) @db.Uuid
  userId      String       @map("user_id") @db.Uuid
  fileName    String       @map("file_name")
  fileType    String       @map("file_type")
  status      ImportStatus @default(PENDING)
  totalRows   Int          @default(0) @map("total_rows")
  validRows   Int          @default(0) @map("valid_rows")
  invalidRows Int          @default(0) @map("invalid_rows")
  createdAt   DateTime     @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("imports")
}


// =========================
// CATEGORIZATION RULE
// =========================

model CategorizationRule {
  id          String @id @default(uuid()) @db.Uuid
  userId      String @map("user_id") @db.Uuid
  categoryId  String @map("category_id") @db.Uuid
  field       String
  condition   String
  value       String
  createdAt   DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([categoryId])
  @@map("categorization_rules")
}


// =========================
// CATEGORY SUGGESTION
// =========================

model Suggestion {
  id            String           @id @default(uuid()) @db.Uuid
  transactionId String           @map("transaction_id") @db.Uuid
  categoryId    String           @map("category_id") @db.Uuid
  source        SuggestionSource
  confidence    Decimal?         @db.Decimal(5, 4)
  status        SuggestionStatus @default(PENDING)
  createdAt     DateTime         @default(now()) @map("created_at")

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  category    Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@index([categoryId])
  @@map("suggestions")
}
