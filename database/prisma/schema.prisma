generator client {
  provider = "prisma-client-js"
  output   = "../../backend/node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String        @id @default(uuid()) @db.Uuid
  email         String        @unique
  passwordHash  String        @map("password_hash")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  accounts      Account[]
  categories    Category[]
  sessions      Session[]
  subcategories Subcategory[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id           String        @id @default(uuid()) @db.Uuid
  userId       String        @map("user_id") @db.Uuid
  name         String
  currency     String        @default("INR")
  balance      Decimal       @default(0) @db.Decimal(15, 2)
  isPrimary    Boolean       @default(false) @map("is_primary")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId])
  @@map("accounts")
}

model Transaction {
  id                   String          @id @default(uuid()) @db.Uuid
  accountId            String          @map("account_id") @db.Uuid
  categoryId           String          @map("category_id") @db.Uuid
  subcategory_id       String          @db.Uuid
  amount               Decimal         @db.Decimal(15, 2)
  type                 TransactionType
  date                 DateTime
  Title                String
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")
  importedWithOverride Boolean         @default(false) @map("imported_with_override")
  overrideNote         String?         @map("override_note")
  account              Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category             Category        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  subcategory          Subcategory     @relation(fields: [subcategory_id], references: [id], onDelete: SetNull)

  @@index([accountId])
  @@index([categoryId])
  @@index([subcategory_id])
  @@index([date])
  @@index([type])
  @@map("transactions")
}

model Category {
  id            String        @id @default(uuid()) @db.Uuid
  userId        String?       @map("user_id") @db.Uuid
  name          String
  type          CategoryType
  icon          String?
  color         String?
  is_default    Boolean       @default(false)
  aliases       String[]      @default([])
  user          User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  subcategories Subcategory[]
  transactions  Transaction[]

  @@index([userId])
  @@index([type])
  @@map("categories")
}

model Subcategory {
  id           String        @id @default(uuid()) @db.Uuid
  category_id  String        @db.Uuid
  user_id      String?       @db.Uuid
  name         String
  icon         String?
  color        String?
  is_default   Boolean       @default(false)
  aliases      String[]      @default([])
  categories   Category      @relation(fields: [category_id], references: [id], onDelete: Cascade)
  users        User?         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([category_id])
  @@index([user_id])
  @@map("subcategories")
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum ImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum SuggestionSource {
  RULE
  SLM
}

enum SuggestionStatus {
  PENDING
  ACCEPTED
  OVERRIDDEN
}

enum CategoryType {
  INCOME
  EXPENSE
}
